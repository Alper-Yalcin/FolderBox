<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderBox.App.Views.FolderTileWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderBox.App.ViewModels"
    xmlns:views="using:FolderBox.App.Views"
    Title="FolderBox tile">

    <Grid x:Name="Root"
          Background="Transparent"
          AllowDrop="True"
          DragEnter="Root_DragEnter"
          DragOver="Root_DragOver"
          DragLeave="Root_DragLeave"
          Drop="Root_Drop"
          PointerEntered="Root_PointerEntered"
          PointerExited="Root_PointerExited"
          PointerPressed="Root_PointerPressed"
          PointerMoved="Root_PointerMoved"
          PointerReleased="Root_PointerReleased"
          PointerCaptureLost="Root_PointerCaptureLost"
          RightTapped="Root_RightTapped"
          KeyDown="Root_KeyDown">

        <!-- Glass card: translucent surface with a hairline border; hover/expanded change the tint -->
        <Border x:Name="Highlight"
                Margin="2"
                CornerRadius="12"
                BorderThickness="1"
                Background="#3C141420"
                BorderBrush="#26FFFFFF" />

        <StackPanel x:Name="TileContent" Margin="4,4,4,2" VerticalAlignment="Top">
            <Grid x:Name="IconHost" Width="48" Height="48" HorizontalAlignment="Center">
                <views:FolderBoxIcon x:Name="TileIcon" />
                <Border x:Name="WarnBadge"
                        Width="20" Height="20"
                        HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,-4,-2"
                        CornerRadius="10"
                        Background="#F2C94C"
                        Visibility="Collapsed">
                    <FontIcon Glyph="&#xE7BA;" FontSize="11" Foreground="#3A2F00" />
                </Border>
            </Grid>

            <Grid>
                <Canvas x:Name="ShadowHost" IsHitTestVisible="False" />
                <TextBlock x:Name="Label"
                           Margin="0,4,0,0"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           MaxLines="2"
                           FontSize="12"
                           LineHeight="16"
                           Foreground="White"
                           SizeChanged="Label_SizeChanged" />
                <TextBox x:Name="RenameBox"
                         Visibility="Collapsed"
                         FontSize="12"
                         MinHeight="24"
                         Padding="4,2,4,2"
                         TextAlignment="Center"
                         TextWrapping="NoWrap"
                         KeyDown="RenameBox_KeyDown"
                         LostFocus="RenameBox_LostFocus" />
            </Grid>

            <TextBlock x:Name="CountLabel"
                       FontSize="11"
                       TextAlignment="Center"
                       Foreground="White"
                       Opacity="0.8"
                       Margin="0,1,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</Window>
