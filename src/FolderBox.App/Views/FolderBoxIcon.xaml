<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="FolderBox.App.Views.FolderBoxIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsHitTestVisible="False">

    <!-- FolderBox tile glyphs. Every design uses two plates: DarkBrush (back) and LightBrush (front),
         computed from the widget's colour in code-behind. Only one Canvas is visible at a time. -->
    <Viewbox Stretch="Uniform">
        <Grid Width="48" Height="48">

            <!-- Flap: back plate with tab, paper, lighter front flap, chevron -->
            <Canvas x:Name="DesignFlap" Width="48" Height="48">
                <Rectangle Canvas.Left="5" Canvas.Top="15" Width="40" Height="29" RadiusX="4" RadiusY="4" Fill="#33000000" />
                <Path x:Name="FlapBack" Data="M 7,9 L 19,9 L 23,13 L 41,13 A 3,3 0 0 1 44,16 L 44,39 A 3,3 0 0 1 41,42 L 7,42 A 3,3 0 0 1 4,39 L 4,12 A 3,3 0 0 1 7,9 Z" />
                <Rectangle Canvas.Left="9" Canvas.Top="16" Width="30" Height="8" RadiusX="1.5" RadiusY="1.5" Fill="#F2FFFFFF" />
                <Path x:Name="FlapFront" Data="M 4,22 L 44,22 L 44,39 A 3,3 0 0 1 41,42 L 7,42 A 3,3 0 0 1 4,39 Z" />
                <Rectangle Canvas.Left="4" Canvas.Top="22" Width="40" Height="2" Fill="#40FFFFFF" />
                <Path Stroke="#E6FFFFFF" StrokeThickness="2.2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 19,30 L 24,35 L 29,30" />
            </Canvas>

            <!-- Modern: soft rounded folder, gradient-like highlight, no glyph -->
            <Canvas x:Name="DesignModern" Width="48" Height="48" Visibility="Collapsed">
                <Rectangle Canvas.Left="5" Canvas.Top="14" Width="40" Height="30" RadiusX="6" RadiusY="6" Fill="#33000000" />
                <Path x:Name="ModernBack" Data="M 8,8 L 20,8 A 3,3 0 0 1 22.5,9.5 L 25,13 L 40,13 A 4,4 0 0 1 44,17 L 44,38 A 4,4 0 0 1 40,42 L 8,42 A 4,4 0 0 1 4,38 L 4,12 A 4,4 0 0 1 8,8 Z" />
                <Path x:Name="ModernFront" Data="M 4,19 L 44,19 L 44,38 A 4,4 0 0 1 40,42 L 8,42 A 4,4 0 0 1 4,38 Z" />
                <Rectangle Canvas.Left="4" Canvas.Top="19" Width="40" Height="10" RadiusX="0" RadiusY="0" Fill="#26FFFFFF" />
            </Canvas>

            <!-- Box: an archive box with a lid -->
            <Canvas x:Name="DesignBox" Width="48" Height="48" Visibility="Collapsed">
                <Rectangle Canvas.Left="6" Canvas.Top="17" Width="38" Height="27" RadiusX="3" RadiusY="3" Fill="#33000000" />
                <Path x:Name="BoxBody" Data="M 8,18 L 40,18 L 40,39 A 3,3 0 0 1 37,42 L 11,42 A 3,3 0 0 1 8,39 Z" />
                <Path x:Name="BoxLid" Data="M 5,10 L 43,10 A 3,3 0 0 1 46,13 L 46,17 A 2,2 0 0 1 44,19 L 4,19 A 2,2 0 0 1 2,17 L 2,13 A 3,3 0 0 1 5,10 Z" />
                <Rectangle Canvas.Left="18" Canvas.Top="24" Width="12" Height="4" RadiusX="2" RadiusY="2" Fill="#B3FFFFFF" />
            </Canvas>

            <!-- Tab: classic two-tone tabbed folder, outline feel -->
            <Canvas x:Name="DesignTab" Width="48" Height="48" Visibility="Collapsed">
                <Rectangle Canvas.Left="5" Canvas.Top="13" Width="40" Height="31" RadiusX="3" RadiusY="3" Fill="#33000000" />
                <Path x:Name="TabBack" Data="M 6,8 L 17,8 L 21,12 L 42,12 A 2,2 0 0 1 44,14 L 44,40 A 2,2 0 0 1 42,42 L 6,42 A 2,2 0 0 1 4,40 L 4,10 A 2,2 0 0 1 6,8 Z" />
                <Path x:Name="TabFront" Data="M 4,17 L 44,17 L 44,40 A 2,2 0 0 1 42,42 L 6,42 A 2,2 0 0 1 4,40 Z" />
                <Path Stroke="#59FFFFFF" StrokeThickness="1.2" Data="M 8,23 L 40,23 M 8,29 L 32,29" />
            </Canvas>

            <!-- Bubble: round badge with a small folder -->
            <Canvas x:Name="DesignBubble" Width="48" Height="48" Visibility="Collapsed">
                <Ellipse Canvas.Left="3" Canvas.Top="4" Width="42" Height="42" Fill="#33000000" />
                <Ellipse x:Name="BubbleBack" Canvas.Left="3" Canvas.Top="3" Width="42" Height="42" />
                <Ellipse Canvas.Left="6" Canvas.Top="6" Width="36" Height="36" Fill="#1FFFFFFF" />
                <Path x:Name="BubbleGlyphBack" Data="M 15,16 L 22,16 L 24,18 L 33,18 A 2,2 0 0 1 35,20 L 35,31 A 2,2 0 0 1 33,33 L 15,33 A 2,2 0 0 1 13,31 L 13,18 A 2,2 0 0 1 15,16 Z" />
                <Path x:Name="BubbleGlyphFront" Data="M 13,22 L 35,22 L 35,31 A 2,2 0 0 1 33,33 L 15,33 A 2,2 0 0 1 13,31 Z" Fill="#F2FFFFFF" />
            </Canvas>
        </Grid>
    </Viewbox>
</UserControl>
