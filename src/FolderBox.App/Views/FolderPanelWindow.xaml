<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FolderBox.App.Views.FolderPanelWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FolderBox.App.ViewModels"
    xmlns:views="using:FolderBox.App.Views"
    Title="FolderBox panel">

    <Grid x:Name="Root" Background="Transparent" KeyDown="Root_KeyDown">
        <Grid.Resources>
            <!-- Glass card look for content items -->
            <SolidColorBrush x:Key="CardFill" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardFillHover" Color="#22FFFFFF" />
            <SolidColorBrush x:Key="CardStroke" Color="#22FFFFFF" />
            <Style x:Key="RoundIconButton" TargetType="Button">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="CornerRadius" Value="18" />
                <Setter Property="Background" Value="{StaticResource CardFill}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStroke}" />
                <Setter Property="BorderThickness" Value="1" />
            </Style>
        </Grid.Resources>

        <Grid x:Name="PanelRoot" Padding="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Height="52" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button x:Name="BackButton"
                        Grid.Column="0"
                        Style="{StaticResource RoundIconButton}"
                        Visibility="{x:Bind views:Bind.VisibleIf(ViewModel.CanGoBack), Mode=OneWay}"
                        AutomationProperties.Name="Back"
                        ToolTipService.ToolTip="Back"
                        Click="BackButton_Click">
                    <FontIcon Glyph="&#xE72B;" FontSize="13" />
                </Button>

                <Grid Grid.Column="1" Width="36" Height="36" VerticalAlignment="Center">
                    <views:FolderBoxIcon x:Name="HeaderIcon" Visibility="{x:Bind views:Bind.VisibleIf(ViewModel.IsAtRoot), Mode=OneWay}" />
                    <Image Source="{x:Bind ViewModel.Icon, Mode=OneWay}" Visibility="{x:Bind views:Bind.CollapsedIf(ViewModel.IsAtRoot), Mode=OneWay}" />
                </Grid>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="0">
                    <TextBlock Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                               FontSize="18" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                    <TextBlock Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxLines="1" />
                </StackPanel>

                <Button x:Name="AddButton"
                        Grid.Column="3"
                        Style="{StaticResource RoundIconButton}"
                        AutomationProperties.Name="Add to this folder"
                        ToolTipService.ToolTip="Add files or folders">
                    <FontIcon Glyph="&#xE710;" FontSize="13" />
                    <Button.Flyout>
                        <MenuFlyout Placement="Bottom">
                            <MenuFlyoutItem Text="Add files…" Click="AddFiles_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8E5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem Text="Add a folder…" Click="AddFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem Text="New folder" Click="NewFolder_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                <Button x:Name="OpenFolderButton"
                        Grid.Column="4"
                        Style="{StaticResource RoundIconButton}"
                        AutomationProperties.Name="Open folder in Explorer"
                        ToolTipService.ToolTip="Open in Explorer"
                        Click="OpenFolderButton_Click">
                    <FontIcon Glyph="&#xE8A7;" FontSize="13" />
                </Button>

                <Button x:Name="CollapseButton"
                        Grid.Column="5"
                        Style="{StaticResource RoundIconButton}"
                        AutomationProperties.Name="Collapse"
                        ToolTipService.ToolTip="Collapse (Esc)"
                        Click="CollapseButton_Click">
                    <FontIcon Glyph="&#xE70E;" FontSize="12" />
                </Button>
            </Grid>

            <!-- Breadcrumb (only inside sub-folders) -->
            <ScrollViewer Grid.Row="1"
                          x:Name="BreadcrumbHost"
                          Height="28"
                          Margin="0,4,0,0"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalScrollMode="Enabled"
                          Visibility="{x:Bind views:Bind.CollapsedIf(ViewModel.IsAtRoot), Mode=OneWay}">
                <ItemsControl ItemsSource="{x:Bind ViewModel.Breadcrumbs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:BreadcrumbSegment">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <HyperlinkButton Content="{x:Bind Label}"
                                                 Tag="{x:Bind Path}"
                                                 Padding="2,2,2,2"
                                                 FontSize="12"
                                                 IsEnabled="{x:Bind views:Bind.Not(IsLast)}"
                                                 Click="Breadcrumb_Click" />
                                <FontIcon Glyph="&#xE76C;" FontSize="9" Margin="2,0,2,0"
                                          Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                          Visibility="{x:Bind views:Bind.CollapsedIf(IsLast)}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" Height="1" Margin="0,10,0,12" Background="{StaticResource CardStroke}" />

            <!-- Items: glass cards in a grid -->
            <Grid Grid.Row="3">
                <GridView x:Name="ItemsList"
                          ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                          SelectedItem="{x:Bind ViewModel.SelectedItem, Mode=TwoWay}"
                          SelectionMode="Single"
                          IsItemClickEnabled="False"
                          Padding="0"
                          CanDragItems="True"
                          DragItemsStarting="ItemsList_DragItemsStarting"
                          DragItemsCompleted="ItemsList_DragItemsCompleted"
                          AllowDrop="True"
                          DragEnter="ItemsList_DragEnter"
                          DragOver="ItemsList_DragOver"
                          DragLeave="ItemsList_DragLeave"
                          Drop="ItemsList_Drop"
                          ContainerContentChanging="ItemsList_ContainerContentChanging"
                          SelectionChanged="ItemsList_SelectionChanged"
                          DoubleTapped="ItemsList_DoubleTapped"
                          RightTapped="ItemsList_RightTapped"
                          KeyDown="ItemsList_KeyDown"
                          AutomationProperties.Name="Folder contents">
                    <GridView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <ItemsWrapGrid Orientation="Horizontal" ItemWidth="128" ItemHeight="126" />
                        </ItemsPanelTemplate>
                    </GridView.ItemsPanel>
                    <GridView.ItemContainerStyle>
                        <Style TargetType="GridViewItem">
                            <Setter Property="Margin" Value="0,0,8,8" />
                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="CornerRadius" Value="14" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="VerticalContentAlignment" Value="Stretch" />
                        </Style>
                    </GridView.ItemContainerStyle>
                    <GridView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FolderItemViewModel">
                            <Border Background="{x:Bind views:Bind.CardBackground(IsSelected), Mode=OneWay}"
                                    BorderBrush="{x:Bind views:Bind.CardStroke(IsSelected), Mode=OneWay}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="6,12,6,8"
                                    AutomationProperties.Name="{x:Bind AutomationName}">
                                <StackPanel Spacing="6">
                                    <Image Width="48" Height="48" HorizontalAlignment="Center" Source="{x:Bind Icon, Mode=OneWay}" />
                                    <Grid>
                                        <StackPanel Visibility="{x:Bind views:Bind.CollapsedIf(IsRenaming), Mode=OneWay}">
                                            <TextBlock Text="{x:Bind Name}" FontSize="13" FontWeight="SemiBold" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                            <TextBlock Text="{x:Bind TypeName}" FontSize="11" TextAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis" MaxLines="1" />
                                        </StackPanel>
                                        <TextBox Text="{x:Bind RenameText, Mode=TwoWay}"
                                                 Visibility="{x:Bind views:Bind.VisibleIf(IsRenaming), Mode=OneWay}"
                                                 FontSize="12" MinHeight="28" Padding="6,3,6,3"
                                                 Loaded="RenameBox_Loaded"
                                                 KeyDown="RenameBox_KeyDown"
                                                 LostFocus="RenameBox_LostFocus" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </GridView.ItemTemplate>
                </GridView>

                <!-- Loading / empty overlays -->
                <ProgressRing Width="28" Height="28" IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}"
                              Visibility="{x:Bind views:Bind.VisibleIf(ViewModel.IsLoading), Mode=OneWay}" />
                <TextBlock Text="{x:Bind ViewModel.EmptyMessage, Mode=OneWay}"
                           Visibility="{x:Bind views:Bind.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock Text="Drop files here or use +"
                           Visibility="{x:Bind views:Bind.VisibleIf(ViewModel.IsEmpty), Mode=OneWay}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,44,0,0"
                           FontSize="11"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
